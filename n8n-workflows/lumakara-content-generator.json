{
  "name": "Lumakara Content Generator",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "generate-content",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "webhook-trigger",
      "name": "Webhook Trigger",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [250, 300]
    },
    {
      "parameters": {
        "jsCode": "// Parse input dari webhook\nconst topic = $input.item.json.body.topic;\nconst audience = $input.item.json.body.audience || 'millennial';\nconst slideCount = $input.item.json.body.slideCount || 7;\nconst tone = $input.item.json.body.tone || 'casual';\n\n// Build prompt untuk AI\nconst prompt = `Buatkan konten carousel Instagram tentang \"${topic}\" untuk target audience ${audience}, dengan ${slideCount} slide. Tone: ${tone}. Output dalam format PHP array sesuai knowledge base.`;\n\nreturn {\n  json: {\n    prompt,\n    topic,\n    audience,\n    slideCount,\n    tone\n  }\n};"
      },
      "id": "prepare-prompt",
      "name": "Prepare Prompt",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [450, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.openai.com/v1/chat/completions",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "openAiApi",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "model",
              "value": "gpt-4-turbo"
            },
            {
              "name": "messages",
              "value": "={{ [{\"role\": \"user\", \"content\": $json.prompt}] }}"
            }
          ]
        },
        "options": {}
      },
      "id": "call-custom-gpt",
      "name": "Call Custom GPT",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [650, 300]
    },
    {
      "parameters": {
        "jsCode": "// Extract response dari GPT\nconst response = $input.item.json.choices[0].message.content;\n\n// Parse PHP array dari response\nconst phpArrayMatch = response.match(/\\$carousel_data\\s*=\\s*array\\((.*?)\\);/s);\nconst phpArray = phpArrayMatch ? phpArrayMatch[0] : response;\n\n// Generate filename\nconst timestamp = new Date().toISOString().split('T')[0];\nconst topic = $input.item.json.topic.toLowerCase().replace(/\\s+/g, '-');\nconst filename = `${timestamp}-${topic}.php`;\n\nreturn {\n  json: {\n    content: phpArray,\n    filename,\n    topic: $input.item.json.topic,\n    audience: $input.item.json.audience,\n    generatedAt: new Date().toISOString()\n  }\n};"
      },
      "id": "process-response",
      "name": "Process Response",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [850, 300]
    },
    {
      "parameters": {
        "operation": "write",
        "fileName": "={{ $json.filename }}",
        "fileContent": "={{ $json.content }}",
        "options": {
          "encoding": "utf8"
        }
      },
      "id": "save-to-file",
      "name": "Save to File",
      "type": "n8n-nodes-base.writeFile",
      "typeVersion": 1,
      "position": [1050, 300]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ {\n  \"success\": true,\n  \"filename\": $json.filename,\n  \"topic\": $json.topic,\n  \"audience\": $json.audience,\n  \"generatedAt\": $json.generatedAt,\n  \"message\": \"Content generated successfully\"\n} }}"
      },
      "id": "respond-webhook",
      "name": "Respond to Webhook",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [1250, 300]
    }
  ],
  "connections": {
    "Webhook Trigger": {
      "main": [[{"node": "Prepare Prompt", "type": "main", "index": 0}]]
    },
    "Prepare Prompt": {
      "main": [[{"node": "Call Custom GPT", "type": "main", "index": 0}]]
    },
    "Call Custom GPT": {
      "main": [[{"node": "Process Response", "type": "main", "index": 0}]]
    },
    "Process Response": {
      "main": [[{"node": "Save to File", "type": "main", "index": 0}]]
    },
    "Save to File": {
      "main": [[{"node": "Respond to Webhook", "type": "main", "index": 0}]]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}
